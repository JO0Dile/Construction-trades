<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only what the app actually does. Each is requested at the moment of
         use, with an in-app rationale first; nothing is asked for at launch.

         Microphone, location and notifications used to be declared here for
         voice dictation, GPS stamping and task reminders. None of those three
         features exists — there is no speech, location or notification code
         in the app at all. Play requires a permission to be necessary for
         functionality, location draws its own declaration form and review,
         and an app that asks a site worker for the microphone and their
         position without using either is not one to hand a ministry. They
         come back with the features, if the features are ever built. -->

    <!-- Site photos, barcode and QR labels. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The update check on the sideloaded build, and nothing else: the app
         is offline-first and never blocks on the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".TradesManagerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TradesManager"
        tools:targetApi="33">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|layoutDirection|locale|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TradesManager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sharing exported PDF/Excel reports without file:// exposure. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Barcode model is downloaded on first scan rather than bundled,
             keeping the base APK small. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />
    </application>
</manifest>
