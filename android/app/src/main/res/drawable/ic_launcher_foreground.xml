<?xml version="1.0" encoding="utf-8"?>
<!-- A folding rule and a wrench, with the flag of Israel under them.

     The tools are the icon and always were. A previous version threw them
     away and left the flag on its own, which was not what was asked for: the
     flag was to be added to the icon, not to become it.

     What was true about that version is that the first flag was too small to
     read — 22x12 units, stripes under a pixel, a star that filled in and
     showed as a blue dot. So this is the tools back, at 0.68 of the size
     they were drawn at to clear a band along the bottom, and the flag in that
     band at 30x22: two and a half times the area of the first attempt, with
     the star drawn as two outlined triangles rather than two filled ones so
     the interlace survives being shrunk.

     The tools are scaled with a group transform rather than by rewriting
     their paths. The wrench is four arcs, and an arc recomputed by hand is
     an arc drawn slightly wrong.

     Everything is inside the adaptive-icon safe zone. A circular launcher
     shows only the centre 66 of this 108 viewport, so nothing may sit more
     than 33 from (54,54). Furthest points, measured rather than eyeballed:
     the flag's bottom corners at 31.76, the wrench's top at 30.69, the
     rule's far end at 24.87. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The tools, as they were drawn, scaled 0.68 about their own centre
         (57.5,47) and moved to sit at (54,41). -->
    <group
        android:pivotX="57.5"
        android:pivotY="47"
        android:scaleX="0.68"
        android:scaleY="0.68"
        android:translateX="-3.5"
        android:translateY="-6">

        <!-- Folding rule, opened to an angle. -->
        <path
            android:fillColor="#FFB300"
            android:pathData="M30,72 L30,64 L62,64 L62,72 Z" />
        <path
            android:fillColor="#FFC94D"
            android:pathData="M62,72 L62,64 L78,38 L85,42 L69,68 Z" />
        <!-- Rule graduations. They fall below a pixel on a small launcher and
             simply vanish, which is what a graduation should do; at settings
             and store sizes they are the difference between a yellow bar and
             a rule. -->
        <path android:fillColor="#1F2933" android:pathData="M38,64 L40,64 L40,68 L38,68 Z" />
        <path android:fillColor="#1F2933" android:pathData="M46,64 L48,64 L48,68 L46,68 Z" />
        <path android:fillColor="#1F2933" android:pathData="M54,64 L56,64 L56,68 L54,68 Z" />

        <!-- Wrench, laid across the rule. -->
        <path
            android:fillColor="#E0E4E8"
            android:pathData="M40,30 A11,11 0 0,0 55,44 L72,61 A5,5 0 0,0 79,54 L62,37 A11,11 0 0,0 48,22 L55,29 L51,37 L43,37 Z" />
    </group>

    <!-- The flag, along the bottom. 30x22 is the flag's own 11:8, stripes an
         eighth of the height set three quarters of a stripe in from each
         edge, star sized to the white band between them. -->

    <!-- White field. Explicitly white, not a theme colour: a flag that turns
         grey in dark mode is not the flag. -->
    <path android:fillColor="#FFFFFF" android:pathData="M39,60h30v22h-30z" />

    <!-- The two stripes, in the flag's own blue. -->
    <path android:fillColor="#0038B8" android:pathData="M39,62.1h30v2.75h-30z" />
    <path android:fillColor="#0038B8" android:pathData="M39,77.2h30v2.75h-30z" />

    <!-- Magen David: two overlapping equilateral triangles, outlined so the
         interlace still reads once the launcher has scaled this down. Filled,
         they merge into one blue lozenge at small sizes. -->
    <path
        android:strokeColor="#0038B8"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M54,66.4 L57.98,73.3 L50.02,73.3 Z" />
    <path
        android:strokeColor="#0038B8"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M54,75.6 L50.02,68.7 L57.98,68.7 Z" />
</vector>
