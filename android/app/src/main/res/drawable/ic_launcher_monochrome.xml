<?xml version="1.0" encoding="utf-8"?>
<!-- The themed-icon layer, which Android tints to one flat colour.

     It used to carry the wrench and folding rule that the colour icon no
     longer has, so a phone with themed icons turned on showed a different
     app from the one in the list.

     Everything here is an outline. A flag filled in a single tint is a solid
     rectangle and says nothing; the same flag as a line drawing keeps its
     stripes, its star and the check, which is what a person actually
     recognises. Same geometry and the same safe zone as the colour layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Flag edge. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M32,30 L76,30 L76,62 L32,62 Z" />

    <!-- The two stripes, kept solid: at this weight they read as bands. -->
    <path android:fillColor="#FFFFFF" android:pathData="M32,33h44v4h-44z" />
    <path android:fillColor="#FFFFFF" android:pathData="M32,55h44v4h-44z" />

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M54,38.2 L60.75,49.9 L47.25,49.9 Z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M54,53.8 L47.25,42.1 L60.75,42.1 Z" />

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M42,72 L50,80 L68,60" />
</vector>
